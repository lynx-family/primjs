{
  "name": "@lynx-js/weak-node-api",
  "version": "0.1.1",
  "license": "Apache-2.0",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "description": "Weak Node-API headers and macOS framework build (CMake & GN) for React Native Node API add-ons",
  "homepage": "https://github.com/lynx-family/primjs",
  "repository": {
    "type": "git",
    "url": "https://github.com/lynx-family/primjs.git",
    "directory": "third_party/weak-node-api"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.12.0",
  "bugs": "https://github.com/lynx-family/primjs/issues",

  "author": "Lynx Team <46469310+RobinWuu@users.noreply.github.com>",
  "contributors": [
    "RobinWuu <46469310+RobinWuu@users.noreply.github.com>"
  ],
  "scripts": {
    "prepare:headers": "node scripts/prepare-headers.mjs",
    "bootstrap": "npm run prepare:headers",
    "build:cmake:macos": "bash tools/cmake/build_macos_framework.sh",
    "build:gn": "bash tools/gn/build_macos_framework.sh",
    "clean": "rm -rf include generated build dist prebuilt out vendor *.tgz"
  },
  "files": [
    "dist/**",
    "include/**",
    "generated/**",
    "defs_header/**",
    "prebuilt/**",
    "prebuilds/**",
    "BUILD.gn",
    "CMakeLists.txt",
    "gn/**",
    "tools/**",
    "scripts/*.mjs",
    "weak-node-api-config.cmake",
    "LICENSE",
    "NOTICE",
    "NOTICE.md",
    "THIRD-PARTY-NOTICES.md",
    "UPSTREAM.md",
    "README.md",
    "licenses/**"
  ],
  "dependencies": {
    "node-addon-api": "^7.1.0",
    "weak-node-api": "0.1.1"
  },
  "devDependencies": {
    "typescript": "^5.8.0"
  }
}
