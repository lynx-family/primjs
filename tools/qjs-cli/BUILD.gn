wasm_common_src = [
  "//src/wasm/common/js_type.h",
  "//src/wasm/common/messages.h",
  "//src/wasm/common/wasm_c_api_dispatch.cc",
  "//src/wasm/common/wasm_c_api_dispatch.h",
  "//src/wasm/common/wasm_log.h",
  "//src/wasm/common/wasm_store_owner.h",
  "//src/wasm/common/wasm_type.h",
  "//src/wasm/common/wasm_utils.h",
]

js_binding_src = [
  "//src/wasm/qjs/js_env_qjs.cc",
  "//src/wasm/qjs/js_env_qjs.h",
  "//src/wasm/qjs/qjs_ext_api.cc",
  "//src/wasm/qjs/qjs_ext_api.h",
  "//src/wasm/qjs/qjs_wasm.cc",
  "//src/wasm/qjs/qjs_wasm.h",
  "//src/wasm/qjs/qjs_wasm_function.cc",
  "//src/wasm/qjs/qjs_wasm_function.h",
  "//src/wasm/qjs/qjs_wasm_instance.cc",
  "//src/wasm/qjs/qjs_wasm_instance.h",
  "//src/wasm/qjs/qjs_wasm_memory.cc",
  "//src/wasm/qjs/qjs_wasm_memory.h",
  "//src/wasm/qjs/qjs_wasm_module.cc",
  "//src/wasm/qjs/qjs_wasm_module.h",
  "//src/wasm/qjs/qjs_wasm_table.cc",
  "//src/wasm/qjs/qjs_wasm_table.h",
]

if (is_mac || is_ios) {
  js_binding_src += [
    "//src/wasm/jsc/js_env_jsc.cc",
    "//src/wasm/jsc/js_env_jsc.h",
    "//src/wasm/jsc/jsc_builtin_objects.cc",
    "//src/wasm/jsc/jsc_builtin_objects.h",
    "//src/wasm/jsc/jsc_class_creator.cc",
    "//src/wasm/jsc/jsc_class_creator.h",
    "//src/wasm/jsc/jsc_ext_api.cc",
    "//src/wasm/jsc/jsc_ext_api.h",
    "//src/wasm/jsc/jsc_wasm.cc",
    "//src/wasm/jsc/jsc_wasm.h",
    "//src/wasm/jsc/jsc_wasm_function.cc",
    "//src/wasm/jsc/jsc_wasm_function.h",
    "//src/wasm/jsc/jsc_wasm_instance.cc",
    "//src/wasm/jsc/jsc_wasm_instance.h",
    "//src/wasm/jsc/jsc_wasm_memory.cc",
    "//src/wasm/jsc/jsc_wasm_memory.h",
    "//src/wasm/jsc/jsc_wasm_module.cc",
    "//src/wasm/jsc/jsc_wasm_module.h",
    "//src/wasm/jsc/jsc_wasm_table.cc",
    "//src/wasm/jsc/jsc_wasm_table.h",
  ]
}

config("wasm_internal_config") {
  include_dirs = [ "//src/wasm/include" ]
}

static_library("qjs_wasm_binding") {
  sources = wasm_common_src + js_binding_src + [ "//src/wasm/prism/prism_dummy.cc" ]
  complete_static_lib = true
  public_deps = [ "//src:quickjs_lib" ]

  public_configs = [
    "//:wasm_public_config",
    "//src/wasm:qjs_priv_config",
    ":wasm_internal_config",
  ]
  if (is_mac || is_ios) {
    frameworks = [ "JavaScriptCore.framework" ]
  }
}

executable("qjs-cli") {
  cflags = [ "-Wno-c99-designator" ]
  sources = [ "quick-cli.cc" ]
  deps = [ ":qjs_wasm_binding" ]
  configs += [ ":wasm_internal_config" ]
}
