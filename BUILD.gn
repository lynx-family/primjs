import("//Primjs.gni")
import("//testing/test.gni")

config("quickjs_public_config") {
  include_dirs = [
    ".",
    "./src/",
    "./src/interpreter",
  ]

  defines = [
    "PRIMJS_MIN_LOG_LEVEL=5",  # disable alog in unittests
    "ENABLE_BUILTIN_SERIALIZE=1",
    "CONFIG_VERSION=\"2019-09-10\"",
    "LYNX_SIMPLIFY=1",
  ]

  if (enable_quickjs_debugger) {
    defines += [ "ENABLE_QUICKJS_DEBUGGER=1" ]
    include_dirs += [
      "./src",
      "./src/inspector",
    ]
  }

  if (use_lepusng) {
    defines += [ "ENABLE_LEPUSNG" ]
  }

  if (use_lepusng_bytecode_opt) {
    defines += [ "ENABLE_LEPUSNG_BYTECODE_OPT" ]
  }

  if (force_gc) {
    defines += [ "FORCE_GC_AT_MALLOC" ]
  }

  if (dump_bytecode) {
    defines += [ "DUMP_BYTECODE" ]
  }

  if (enable_mem) {
    defines += [
      "DUMP_LEAKS",
      "DEBUG_MEMORY",
      "DUMP_LEAKS",
    ]
  }

  if (enable_primjs_snapshot) {
    defines += [ "ENABLE_PRIMJS_SNAPSHOT" ]

    # The pre-generated macOS and iOS handlers use vm_codegen's -virtual-sp
    # mode, so the runtime must initialize the matching virtual stack.
    if (target_os == "mac" || target_os == "ios") {
      defines += [ "ENABLE_VIRTUAL_STACK" ]
    }
  }

  if (enable_compatible_mm) {
    defines += [ "ENABLE_COMPATIBLE_MM" ]
  }

  if (enable_ros_force_gc) {
    defines += [ "ROS_FORCE_GC" ]
  }

  if (enable_conmark_checker) {
    defines += [ "CONMARK_CHECKER_ENABLE" ]
  }

  if (enable_ros_debug) {
    defines += [ "ROS_DEBUG" ]
  }

  if (enable_gc_log) {
    defines += [ "ENABLE_GC_LOG" ]
  }

  if (enable_primjs_trace) {
    defines += [ "ENABLE_PRIMJS_TRACE" ]
  }

  if (enable_unittests) {
    defines += [
      "QJS_UNITTEST",
      "HEAPPROFILER_UNITTEST",
    ]
  }

  if (enable_tracing_gc) {
    defines += [ "ENABLE_TRACING_GC" ]
  }

  cflags_cc = [
    "-Wno-unused-private-field",
    "-Wno-unused-variable",
    "-Wno-unused-local-typedef",
    "-Wno-sometimes-uninitialized",
    "-Wno-uninitialized",
    "-Wno-unused-function",
    "-Wno-format",
    "-Wno-unused-but-set-variable",
    "-Wno-unknown-warning-option",
    "-Wno-sign-compare",
  ]
  if (target_os != "android" || current_toolchain == snapshot_toolchain) {
    cflags_cc += [
      "-Wno-c99-designator",
      "-Wno-reorder-init-list",
    ]
  }
}

config("napi_public_config") {
  include_dirs = [
    ".",
    "./src",
    "./src/napi",
    "./src/napi/adapter",
    "./src/napi/common",
    "./src/napi/env",
    "./src/napi/internal",
    "./src/napi/jsc/",
    "./src/napi/quickjs",
    "./src/napi/v8",
    "./src/interpreter",
  ]

  defines = [
    "PRIMJS_MIN_LOG_LEVEL=5",  # disable alog in unittests
  ]
  if (is_win) {
    defines += [ "OS_WIN=1" ]
  }
  if (use_primjs_napi) {
    defines += [ "USE_PRIMJS_NAPI" ]
  }
  if (use_rtti) {
    defines += [ "NAPI_CPP_RTTI" ]
  } else {
    defines += [ "NAPI_DISABLE_CPP_RTTI" ]
  }
}

config("wasm_public_config") {
  include_dirs = [
    "./src/wasm",
  ]

  defines = []

  if (is_debug) {
    defines += [
      "WASM_DEBUG",
      "DEBUG",
      "LOG_LEVEL=LOG_LEVEL_VERBOSE",
      "d_m3HasTracer",
    ]
  } 
}

group("all") {
  deps = [ "src:src" ]

  if (enable_unittests) {
    testonly = true
    deps += [ "./testing" ]
  }
}

group("cli") {
  testonly = true
  deps = []
  if (is_mac || is_ios) {
    deps += [
      "//tools/qjs-cli",
    ]
  }
}
