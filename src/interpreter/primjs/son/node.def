#ifndef DEF_NODE_KIND
#define DEF_NODE_KIND(...)
#endif

#ifndef DEF_COMMON_IR
#define DEF_COMMON_IR(name, f, k) DEF_NODE_KIND(name, f, k)
#endif

#ifndef DEF_MIR
#define DEF_MIR(name, f, k) DEF_NODE_KIND(name, f, k)
#endif

#ifndef DEF_META_KIND
#define DEF_META_KIND(...)
#endif

#ifndef DEF_META_FLAG
#define DEF_META_FLAG(...)
#endif

#ifndef DEF_NODE_CONSTANT
#define DEF_NODE_CONSTANT(...)
#endif

DEF_META_KIND(Meta0)
DEF_META_KIND(Meta1)

DEF_META_FLAG(None, 0)
DEF_META_FLAG(Throw, 1 << 0)
DEF_META_FLAG(Control, 1 << 1)
DEF_META_FLAG(NoWrite, 1 << 2)
DEF_META_FLAG(NoRead, 1 << 3)

DEF_COMMON_IR(Dead, None, Meta0)
