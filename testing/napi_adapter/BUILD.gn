import("//testing/test.gni")

unittest_set("napi_adapter_testset") {
  defines = [
    "JS_ENGINE_QJS",
    "JS_ENGINE_V8",
  ]
  configs = [ ":weak_node_api_config" ]
  if (target_os == "mac") {
    cflags_cc = [ "-mmacosx-version-min=10.15" ]
  }
  public_deps = [ "../../src/napi:napi_v8" ]
  deps = [
    ":test_js",
    ":weak_node_api_source",
    "../../src/napi:napi",
    "../../src/napi:napi_env",
    "../../src/napi:napi_quickjs",
    "../../src/napi:napi_runtime",
    "../../src/napi/adapter",
  ]
  deps += [
    "js_native_api:js_native_api",
    "js_native_api/2_function_arguments",
    "js_native_api/3_callbacks",
    "js_native_api/3_callbacks_primjs_extra_tests",
    "js_native_api/4_object_factory",
    "js_native_api/5_function_factory",
    "js_native_api/6_object_wrap",
    "js_native_api/7_factory_wrap",
    "js_native_api/8_passing_wrapped",
    "js_native_api/test_array",
    "js_native_api/test_bigint",
    "js_native_api/test_class_inheritance",
    "js_native_api/test_constructor",
    "js_native_api/test_conversions",
    "js_native_api/test_dataview",
    "js_native_api/test_date",
    "js_native_api/test_error",
    "js_native_api/test_exception",
    "js_native_api/test_function",
    "js_native_api/test_general",
    "js_native_api/test_handle_scope",
    "js_native_api/test_instance_data",
    "js_native_api/test_new_target",
    "js_native_api/test_number",
    "js_native_api/test_object",
    "js_native_api/test_promise",
    "js_native_api/test_properties",
    "js_native_api/test_reference",
    "js_native_api/test_string",
    "js_native_api/test_symbol",
    "js_native_api/test_threadsafe_function",
    "js_native_api/test_typedarray",
  ]
  if (target_os == "mac") {
    defines += [ "JS_ENGINE_JSC" ]
    deps += [ "../../src/napi:napi_jsc" ]
  }
  sources = [
    "napi_adapter_unittests.cc",
    "napi_adapter_unittests.h",
  ]
}

unit_test("napi_adapter_unittest") {
  testonly = true

  sources = []

  public_deps = [ ":napi_adapter_testset" ]
}

config("weak_node_api_config") {
  include_dirs = [
    "../../packages/weak-node-api",
    "../../packages/weak-node-api/headers",
    "../../packages/weak-node-api/generated",
    "../../packages/weak-node-api/shim",
    "../../packages/weak-node-api/defs_header",
  ]
  defines = [ "USE_WEAK_SUFFIX_NAPI" ]
}

unittest_set("weak_node_api_source") {
  configs = [
    "//:napi_public_config",
    ":weak_node_api_config",
  ]
  sources = [
    "../../packages/weak-node-api/generated/weak_node_api.cpp",
    "../../src/napi/adapter/weak_napi_host_generator.cc",
    "../../src/napi/adapter/weak_napi_host_injector.cc",
  ]
}

action("test_js") {
  testonly = true
  script = "build_js.py"
  sources = [
    "common/index.js",
    "package.json",
    "pnpm-lock.yaml",
  ]
  sources += [
    "js_native_api/2_function_arguments/test.js",
    "js_native_api/3_callbacks/test.js",
    "js_native_api/3_callbacks_primjs_extra_tests/test.js",
    "js_native_api/4_object_factory/test.js",
    "js_native_api/5_function_factory/test.js",
    "js_native_api/6_object_wrap/test.js",
    "js_native_api/7_factory_wrap/test.js",
    "js_native_api/8_passing_wrapped/test.js",
    "js_native_api/test_array/test.js",
    "js_native_api/test_bigint/test.js",
    "js_native_api/test_class_inheritance/test.js",
    "js_native_api/test_constructor/test.js",
    "js_native_api/test_constructor/test1.js",
    "js_native_api/test_conversions/test.js",
    "js_native_api/test_dataview/test.js",
    "js_native_api/test_date/test.js",
    "js_native_api/test_error/test.js",
    "js_native_api/test_exception/test.js",
    "js_native_api/test_function/test.js",
    "js_native_api/test_general/test.js",
    "js_native_api/test_general/testEnvCleanup.js",
    "js_native_api/test_general/testFinalizer.js",
    "js_native_api/test_general/testGlobals.js",
    "js_native_api/test_general/testNapiRun.js",
    "js_native_api/test_general/testNapiStatus.js",
    "js_native_api/test_handle_scope/test.js",
    "js_native_api/test_instance_data/test.js",
    "js_native_api/test_new_target/test.js",
    "js_native_api/test_number/test.js",
    "js_native_api/test_object/test.js",
    "js_native_api/test_object/test_null.js",
    "js_native_api/test_promise/test.js",
    "js_native_api/test_properties/test.js",
    "js_native_api/test_reference/test.js",
    "js_native_api/test_string/test.js",
    "js_native_api/test_symbol/test1.js",
    "js_native_api/test_symbol/test2.js",
    "js_native_api/test_symbol/test3.js",
    "js_native_api/test_threadsafe_function/test.js",
    "js_native_api/test_typedarray/test.js",
  ]
  outputs = [ "$target_gen_dir/test_js.stamp" ]
  args = [
    "--stamp",
    rebase_path(outputs[0], root_build_dir),
  ]
}
